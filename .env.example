# Name of the running CAIPE Compose network (inspect with docker network ls).
CAIPE_NETWORK=caipe_default

# OpenAI-compatible endpoint, including LiteLLM. Set your own key and model.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=
OPENAI_API_KEY=

# Netutils MCP service on the CAIPE network.
NETUTILS_MCP_URL=http://mcp-netutils:8000/mcp
NETUTILS_AGENT_URL=http://netutils-agent:8120/
NETUTILS_HOST_PORT=8120
# Direct A2A discovery and calls require Keycloak JWTs; health remains public.
NETUTILS_OIDC_ISSUER=http://localhost:7080/realms/caipe
NETUTILS_OIDC_AUDIENCE=caipe-platform
NETUTILS_JWKS_URL=http://keycloak:7080/realms/caipe/protocol/openid-connect/certs

# Always advertise the gateway, never the private Weather backend.
WEATHER_AGENT_URL=http://weather-agentgateway:4000/
WEATHER_GATEWAY_HOST_PORT=4010
# Copy/edit this file if Keycloak uses a custom realm, issuer or port.
WEATHER_GATEWAY_CONFIG=./deploy/agentgateway/config.a2a-weather.yaml
